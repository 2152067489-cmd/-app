# ============================================================
# 史迪奇学习乐园 - 环境变量配置
# ============================================================
# 本地开发：复制为 .env，用 `vercel dev` 启动
# Vercel 部署：在 Vercel 项目设置 → Environment Variables 中填写

# Supabase 数据库（必填）
SUPABASE_URL=https://你的项目.supabase.co
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key
SUPABASE_ANON_KEY=你的anon_key

# JWT 密钥（必填，务必修改为随机长字符串）
JWT_SECRET=please_change_this_to_a_random_long_string

# 虎皮椒支付配置（不填则进入开发模式）
XUNHUPAY_APP_ID=你的商户APPID
XUNHUPAY_APP_SECRET=你的商户密钥
# 回调地址必须是公网 HTTPS URL
XUNHUPAY_NOTIFY_URL=https://你的域名/api/pay/notify
XUNHUPAY_RETURN_URL=https://你的域名/study-checkin.html
