# ============================================================
# 史迪奇学习乐园 - 后端环境变量配置（公开网站版）
# ============================================================
# 复制本文件为 .env 并填写真实参数

# 服务器配置
HOST=0.0.0.0
PORT=3000
# JWT 密钥：务必修改为一个随机长字符串（生产环境）
JWT_SECRET=please_change_this_to_a_random_long_string

# CORS 允许的来源（逗号分隔）
# 开发环境用 *，生产环境建议指定域名，如：
# CORS_ORIGINS=https://stitch.example.com,https://www.stitch.example.com
CORS_ORIGINS=*

# 注册限流：同一 IP 在时间窗口内最多注册 N 次
REGISTER_WINDOW_MS=3600000
REGISTER_MAX=5

# 虎皮椒（xunhupay）支付配置
# 注册地址：https://www.xunhupay.com
XUNHUPAY_APP_ID=你的商户APPID
XUNHUPAY_APP_SECRET=你的商户密钥
# 异步回调地址（必须是公网可访问的URL，指向本服务的 /api/pay/notify）
# 开发调试时用 ngrok 内网穿透，参考 README.md
XUNHUPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
# 支付同步跳转地址（用户支付完成后浏览器跳转，指向前端页面）
XUNHUPAY_RETURN_URL=https://your-domain.com/study-checkin.html
